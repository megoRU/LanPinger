{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LanPinger",
  "version": "../package.json",
  "identifier": "ru.mego.lanpinger",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LanPinger",
        "width": 1280,
        "height": 800,
        "backgroundColor": "#0d1113",
        "decorations": true,
        "visible": false,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost https://github.com https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": ["nsis", "appimage", "deb", "rpm", "dmg"],
    "category": "Utility",
    "shortDescription": "Network route monitor",
    "longDescription": "A compact, continuous ICMP route monitor for IPv4 and IPv6.",
    "createUpdaterArtifacts": false,
    "macOS": {
      "minimumSystemVersion": "15.0",
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      },
      "hardenedRuntime": false,
      "signingIdentity": null
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Russian"],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBMjJDQTg4Njg5QUIwRjcKUldUM3NKcG9pTW9pR3IyTEFXTk5Qc1ViVFZtc3hGTXN2aGw4Qkt5cEN5anp0T0Fva3pRY2JYaUIK",
      "endpoints": [
        "https://github.com/megoRU/LanPinger/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "allowDowngrades": false,
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
